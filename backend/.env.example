APP_NAME=SIJAMA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sijama
DB_USERNAME=sijama
DB_PASSWORD=sijama
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Upload disk for user files (photos, konfig assets). Production: s3 (R2)
FILESYSTEM_UPLOAD_DISK=public
# Production Render + R2: FILESYSTEM_DISK=s3 and FILESYSTEM_UPLOAD_DISK=s3 (see docs/render-deploy.md)
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@sijama.local"
MAIL_FROM_NAME="${APP_NAME}"

# Reset password — base URL tautan di email
FRONTEND_URL=http://localhost:5173

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_MAPS_API_KEY=

# api.co.id — hari libur nasional & cuti bersama (gratis, 0 points/hit)
API_CO_ID_HOLIDAY_ENABLED=true
API_CO_ID_API_KEY=
API_CO_ID_HOLIDAY_BASE_URL=https://use.api.co.id/holidays/indonesia

VITE_APP_NAME="${APP_NAME}"
