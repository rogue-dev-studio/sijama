# SIJAMA Docker Compose — copy to .env and adjust if needed
# cp .env.example .env

# PostgreSQL (db service)
POSTGRES_DB=sijama
POSTGRES_USER=sijama
POSTGRES_PASSWORD=sijama
DB_PORT=5432

# Backend (Laravel)
BACKEND_PORT=8080
APP_NAME=SIJAMA
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

# Frontend (Vite build arg — baked into SPA at image build time)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Reset password
# ---------------------------------------------------------------------------
# FRONTEND_URL = base URL SPA untuk tautan reset di email
#   Dev:  http://localhost:5173
#   Prod: https://app.domainanda.com  (exact, https, tanpa slash akhir)
FRONTEND_URL=http://localhost:5173

# Mail — reset password via email
# Dev lokal: MAIL_MAILER=log (isi email tampil di `docker compose logs backend`)
# SMTP contoh (Mailtrap / Gmail / office365):
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=587
#   MAIL_USERNAME=your-user
#   MAIL_PASSWORD=your-pass
#   MAIL_ENCRYPTION=tls
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@sijama.local
MAIL_FROM_NAME="${APP_NAME}"

# Reset via email — default ON
PASSWORD_RESET_EMAIL_ENABLED=true
# Reset via no. HP (OTP) — sementara OFF (maintenance)
# Aktifkan bila gateway SMS siap: PASSWORD_RESET_PHONE_ENABLED=true
PASSWORD_RESET_PHONE_ENABLED=false
# Dev lokal: SMS_DRIVER=log → OTP tampil di `docker compose logs backend`
# Production (Fonnte WhatsApp/SMS): https://fonnte.com
#   SMS_DRIVER=fonnte
#   FONNTE_TOKEN=your-fonnte-token
SMS_DRIVER=log
FONNTE_TOKEN=
FONNTE_ENDPOINT=https://api.fonnte.com/send
SMS_COUNTRY_CODE=62

# Telegram Bot (notifikasi / otomasi)
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DEFAULT_CHAT_ID=

# n8n (workflow automation)
N8N_ENABLED=false
N8N_BASE_URL=
N8N_WEBHOOK_URL=
N8N_API_KEY=

# api.co.id — hari libur nasional & cuti bersama (gratis, 0 points/hit)
API_CO_ID_HOLIDAY_ENABLED=true
API_CO_ID_API_KEY=
API_CO_ID_HOLIDAY_BASE_URL=https://use.api.co.id/holidays/indonesia
