# Production env on deploy server (/opt/sijama/.env.production)
# Copy to server once; DB credentials from Aiven Console.

APP_NAME=SIJAMA
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=pgsql
DB_HOST=pg-1a25e67a-sijama.k.aivencloud.com
DB_PORT=25559
DB_DATABASE=sijama
DB_USERNAME=avnadmin
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

FRONTEND_URL=https://app.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com

# api.co.id — hari libur
API_CO_ID_HOLIDAY_ENABLED=true
API_CO_ID_API_KEY=
API_CO_ID_HOLIDAY_BASE_URL=https://use.api.co.id/holidays/indonesia

BACKEND_PORT=8080
FRONTEND_PORT=80
