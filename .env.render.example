# Env vars untuk Render Web Service (sijama-api) — isi di Render Dashboard, jangan commit nilai nyata.
# Frontend (sijama-web) otomatis dapat VITE_API_URL dari render.yaml.

APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=pgsql
DB_HOST=pg-1a25e67a-sijama.k.aivencloud.com
DB_PORT=25559
DB_DATABASE=sijama
DB_USERNAME=avnadmin
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require

# APP_URL dan FRONTEND_URL di-set otomatis oleh render.yaml (RENDER_EXTERNAL_URL).

# Seed sekali tanpa Shell (free tier): set true → Manual Deploy → pantau Logs → hapus var ini.
# SEED_ON_DEPLOY=true

# Jika RBAC/admin sudah ada, cukup jalankan scripts/seed-aiven-remaining.sh (via Shell atau entrypoint custom).

# Akun Super Admin pertama (wajib saat SEED_ON_DEPLOY=true):
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
# BOOTSTRAP_ADMIN_PASSWORD=GantiPasswordKuatMin8
# BOOTSTRAP_ADMIN_NAME=Super Admin SIJAMA
