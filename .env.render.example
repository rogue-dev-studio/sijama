# Env vars untuk Render Web Service (sijama-api) — isi di Render Dashboard, jangan commit nilai nyata.
# Frontend (sijama-web) otomatis dapat VITE_API_URL dari render.yaml.

APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=pgsql
DB_HOST=pg-1a25e67a-sijama.k.aivencloud.com
DB_PORT=25559
DB_DATABASE=sijama
DB_USERNAME=avnadmin
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require

# APP_URL dan FRONTEND_URL di-set otomatis oleh render.yaml (RENDER_EXTERNAL_URL).
